# Unreal generated content
game/Binaries/
game/Intermediate/
game/Saved/
game/DerivedDataCache/
game/Build/
game/.vs/
game/*.sln
game/*.xcodeproj/
game/*.xcworkspace/

# Private or source-redistribution-restricted dependencies
game/Content/ExternalRestricted/
private/
.env
.env.*
*.pfx
*.p12
*.key
*.cer
*.ekb
*.lekb
*.pem

# Build artifacts and local caches
build/
dist/
output/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.log
core.*
*.core
*.tmp
*.orig
*.rej
*.swp
*~
.claude/

# Packaged builds are regenerable with tools/build/package-game.sh
packaging/Linux/Engine/
packaging/Linux/QinglanAscension/
packaging/windows/Engine/
packaging/windows/QinglanAscension/
packaging/windows/*.exe

# Portable build entry points are tracked despite the global build/ ignore
!tools/build/
packaging/LinuxDev/

# Removable workspace-local toolchains, assets, downloads, and caches
/.local/
packaging/Mac/
packaging/Win64/
packaging/Windows/Engine/
packaging/Windows/QinglanAscension/
packaging/Windows/*.exe
